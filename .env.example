# Development-only credentials. Set unique secrets outside local development.
POSTGRES_DB=denger
POSTGRES_PASSWORD=dia_owner_dev_only
APP_DB_PASSWORD=dia_app_dev_only
REPORT_DB_PASSWORD=dia_report_dev_only
POSTGRES_PORT=5432
REDIS_PORT=6379
CORS_ORIGINS=https://localhost
TLS_MODE=development
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
ENCRYPTION_ACTIVE_KEY_ID=1
# WAJIB diisi sendiri; jangan pernah memakai kunci yang pernah ter-commit.
# Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY_1=
# Generate an age keypair; keep its private identity outside this repository.
BACKUP_AGE_RECIPIENT=age1replace_with_your_public_recipient
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETRY_SECONDS=300
BACKUP_RETENTION_DAYS=14
JWT_ISSUER=dia-backend
JWT_AUDIENCE=dia-api
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_SAME_SITE=lax
# Jendela toleransi (detik) bagi refresh paralel dari beberapa tab sebelum dianggap reuse.
REFRESH_REUSE_GRACE_SECONDS=10
# MFA staf wajib; default true saat NODE_ENV=production.
STAFF_MFA_REQUIRED=false
# Configure these after receiving OIDC client details from campus IT.
SSO_PROTOCOL=oidc
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://localhost/api/v1/auth/sso/callback
OIDC_NIM_CLAIM=nim
OIDC_SCOPES=openid email profile
# Integrasi akademik: mock aktif untuk NIM yang dicantumkan; mode http memakai API kampus.
AKADEMIK_MODE=mock
AKADEMIK_STATUS_URL=
AKADEMIK_API_TOKEN=
AKADEMIK_MOCK_ACTIVE_NIMS=
# Toleransi (jam) status DB saat API akademik gangguan; minimal 24.
AKADEMIK_TOLERANSI_GANGGUAN_JAM=72
FRONTEND_LOGIN_SUCCESS_URL=https://localhost/
FRONTEND_LOGIN_FAILURE_URL=https://localhost/masuk
# Genta (SOS) langkah konfirmasi; nilai default di bawah.
SOS_KONFIRMASI_TTL_DETIK=120
SOS_JEDA_MINIMAL_MS=800
# Ambang SOS per jam / laporan tidak valid / pembatalan diatur admin: PUT /api/v1/admin/konfigurasi-sos
# Realtime: zona waktu jadwal jaga psikolog dan adapter Redis Socket.IO.
JADWAL_ZONA_WAKTU=Asia/Jakarta
REALTIME_REDIS_ADAPTER=true
# Eskalasi SOS: matikan worker BullMQ pada instance tertentu (sweeper DB tetap aktif).
ESKALASI_WORKER_AKTIF=true
# SMS gateway eskalasi: console (simulasi) | http. Produksi wajib http + HTTPS.
SMS_PROVIDER=console
SMS_GATEWAY_URL=
SMS_GATEWAY_TOKEN=
SMS_SENDER_ID=
SMS_RETRY_BACKOFF_MS=1000
# Booking konseling (PBI-10): slot dipecah dari jadwal_jaga psikolog.
SESI_DURASI_MENIT=50
SESI_JEDA_MENIT=10
BOOKING_MIN_SEBELUM_MENIT=60
BOOKING_HORIZON_HARI=30
BOOKING_MAKS_SESI_AKTIF=3
# Ruang sesi (PBI-11): psikolog boleh memulai sesi sekian menit sebelum jadwal; anti-banjir pesan.
SESI_MULAI_LEBIH_AWAL_MENIT=10
SESI_MAKS_PESAN_PER_10_DETIK=30
# Pengingat sesi (PBI-14): offset menit sebelum sesi, retry email, worker per instance.
PENGINGAT_OFFSET_MENIT=1440,60
PENGINGAT_MAKS_PERCOBAAN=3
PENGINGAT_RETRY_DASAR_DETIK=60
PENGINGAT_WORKER_AKTIF=true
# Email gateway: console (simulasi) | http. Produksi wajib http + HTTPS.
EMAIL_PROVIDER=console
EMAIL_GATEWAY_URL=
EMAIL_GATEWAY_TOKEN=
EMAIL_PENGIRIM=
# Logging (nestjs-pino; header auth/cookie disamarkan) dan Swagger UI di /api/docs (default nonaktif di produksi).
LOG_LEVEL=
SWAGGER_AKTIF=
