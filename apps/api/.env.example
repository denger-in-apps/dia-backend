# Untuk menjalankan API langsung di host (tanpa docker compose).
# Konfigurasi lengkap dan penjelasannya ada di /.env.example dan docs/README.md.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://denger_app:CHANGE_ME@localhost:5432/denger
REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ORIGINS=https://localhost

# JWT memakai RS256 dari file kunci (node infra/auth/generate-dev-jwt-keys.cjs)
JWT_PRIVATE_KEY_PATH=../../infra/auth/jwt_private.pem
JWT_PUBLIC_KEY_PATH=../../infra/auth/jwt_public.pem
JWT_ISSUER=dia-backend
JWT_AUDIENCE=dia-api

# Wajib diisi kunci acak 32 byte (base64):
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_ACTIVE_KEY_ID=1
ENCRYPTION_KEY_1=

STAFF_MFA_REQUIRED=false
REFRESH_REUSE_GRACE_SECONDS=10
AKADEMIK_MODE=mock
FRONTEND_LOGIN_SUCCESS_URL=https://localhost/
FRONTEND_LOGIN_FAILURE_URL=https://localhost/masuk
